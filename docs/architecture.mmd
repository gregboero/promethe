---
title: Prométhé — Architecture Complète
---
graph TB
    subgraph Clients["🖥️ Clients"]
        direction LR
        Desktop["Compose Desktop<br/>(Windows/Mac/Linux)"]
        Wasm["Compose WasmJS<br/>(Browser)"]
        Android["Compose Android<br/>(Mobile)"]
        iOS["Compose iOS<br/>(Mobile)"]
        CLI["CLI (--cli / --connect)"]
    end

    subgraph Gateway["⚡ Gateway (Ktor Server — :8080)"]
        direction TB
        subgraph Routes["Routes HTTP/WS"]
            REST["/api/v1/sessions GET/POST<br/>/api/v1/agents CRUD<br/>/api/v1/status GET<br/>/api/v1/feedback GET/POST<br/>/api/v1/mcp/servers CRUD<br/>/api/v1/skills CRUD<br/>/api/v1/goals<br/>/health GET"]
            MemRoutes["/api/v1/memory/facts GET/DELETE<br/>/api/v1/memory/status GET"]
            ConfigRoutes["/api/v1/config/env GET/PUT/DELETE<br/>/api/v1/channels GET/PUT/POST<br/>/api/v1/scheduler/tasks CRUD"]
            ApprovalRoutes["/api/v1/approval/pending GET<br/>/api/v1/approval/{id} POST"]
            WS["/ws/agents WebSocket (monitor)"]            A2ARoute["/agents/ JSON-RPC POST<br/>/.well-known/agent.json GET"]
            Webhooks["/webhook/telegram POST<br/>/webhook/discord POST<br/>/webhook/slack POST"]
            Export["/api/v1/sessions/{id}/export GET"]
        end
        subgraph Security["🔒 Security Layer"]
            Auth["AuthMiddleware (JWT)"]
            RL["RateLimiter (token bucket)"]
            WH["WebhookAuth (HMAC/Ed25519)"]
        end
    end

    subgraph Core["🧠 Agent Core (commonMain — KMP)"]
        direction TB
        subgraph PRA["Plan-Reason-Act Loop"]
            Agent["AIAgent — executeLoop()"]
            RS["ResilienceStrategy<br/>L1:Retry → L2:Replan → L3:Decompose"]
        end
        subgraph Tools["🔧 Tool System"]
            TR["ToolRegistry"]
            BT["BuiltinTools<br/>(terminal, file_read, file_write, http_fetch)"]
            GT["GitTool"]
            PT["PatchFileTool"]
            MCP_P["McpProxyTool"]
            ST["ScopedToolRegistry (per-agent)"]
        end
        subgraph MemoryCtx["💾 Memory and Context"]
            ML["MemoryLayer<br/>4 tiers: ATOMIC → COMPOUND → SYNTHESIS → META"]
            CC["ContextCompressor (auto @75%)"]
            SL["SkillLoader + Cache + KeywordIndex"]
            subgraph MemProviders["Memory Providers"]
                EMP["EmbeddedMemoryProvider<br/>(SQLite + FTS5)"]
                HMP["HonchoMemoryProvider<br/>(REST)"]
                TMP["TencentMemoryProvider<br/>(REST)"]
                FBP["FallbackMemoryProvider<br/>(primary + fallback)"]
            end
        end
        subgraph Eval["📊 Evaluation"]
            TE["TrajectoryEvaluator"]
            RW["RewardSignal"]
            FC_E["FeedbackCollector"]
            GEPA["GepaEngine + Mutations + ParetoSelector"]
        end
        subgraph MultiAgent["👥 Multi-Agent"]
            AO["AgentOrchestrator"]
            DT["DelegateTaskTool"]
        end
    end

    subgraph LLM["🤖 LLM Routing"]
        KLA["KoogLlmAdapter"]
        MMR["MultiModelRouter"]
        FCH["FallbackChain (auto-discovery)"]
        MPS["ModelPricingService"]
    end

