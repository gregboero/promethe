    %% Client to Gateway
    Desktop -->|"HTTP + WS"| Gateway
    Wasm -->|"HTTP + WS"| Gateway
    Android -->|"HTTP + WS"| Gateway
    iOS -->|"HTTP + WS"| Gateway
    CLI -->|"HTTP"| Gateway

    %% Gateway to Core
    REST --> Auth --> Agent
    WS --> Agent
    Webhooks --> WH --> Agent
    A2ARoute --> A2AExec --> Agent

    %% Core internal
    Agent --> RS
    Agent --> TR
    Agent --> ML
    Agent --> CC
    Agent --> AO --> DT --> Agent
    TR --> BT
    TR --> GT
    TR --> PT
    TR --> MCP_P
    Agent --> TE --> GEPA

    %% Core to LLM
    Agent --> KLA --> MMR --> FCH
    FCH --> MPS

    %% Core to MCP
    MCP_P --> Bridge --> Factory
    Factory --> Stdio
    Factory --> SSE

    %% Core to DB
    Agent --> DB
    ML --> FBP --> EMP
    FBP -.-> HMP
    FBP -.-> TMP
    EMP --> DB
    CS_DB --> DB

    %% Observability
    Agent --> Tracing
    Tracing --> ConsoleExp
    Tracing -.-> LangfuseExp
    Tracing -.-> OtlpExp

    %% LLM to External
    FCH -->|"HTTPS"| OpenAI
    FCH -->|"HTTPS"| Anthropic
    FCH -->|"HTTPS"| Google
    FCH -->|"HTTP"| Ollama
    FCH -->|"HTTPS"| OpenRouter
    FCH -->|"HTTPS"| DeepSeek
    FCH -->|"HTTPS"| NVIDIA
    FCH -->|"HTTP"| LiteLLM

    %% MCP to External
    Stdio -->|"stdin/stdout JSON-RPC"| MCP1
    SSE -->|"HTTP/SSE JSON-RPC"| MCP1

    %% Search
    BT -->|"HTTPS"| Tavily
    BT -->|"HTTPS"| Brave
    BT -->|"HTTPS"| DDG
    BT -->|"HTTP"| SearX

    %% Channels to External
    TG -->|"HTTPS"| TG_API
    DC -->|"HTTPS"| DC_API
    SLK -->|"HTTPS"| SLK_API
    TG_API -.->|"Webhook"| Webhooks
    SLK_API -.->|"Events"| Webhooks

    %% A2A
    A2AClient -->|"HTTPS JSON-RPC"| EA
    EA -.->|"JSON-RPC"| A2ARoute

    %% Channel wiring
    Gateway --> TG
    Gateway --> DC
    Gateway --> SLK
    Gateway --> WA
    Gateway --> SIG
    Gateway --> MTX

    %% Channels to External
    WA -->|"HTTPS"| WA_API
    SIG -->|"HTTP"| SIG_API
    MTX -->|"HTTPS"| MTX_API

    %% Config Env wiring
    ConfigRoutes --> ENV_DB
    ApprovalRoutes --> Agent
