# ── Promethe ──────────────────────────────────────────────────
# Copy this file to `.env` and fill in your API keys.
#
#   cp .env.example .env
#
# Only ONE provider key is required. Fill in whichever you use.
# ──────────────────────────────────────────────────────────────

# ╔══════════════════════════════════════════════════════════════╗
# ║  LLM Provider Keys (fill at least ONE)                      ║
# ╚══════════════════════════════════════════════════════════════╝

# OpenRouter — access 200+ models with one key (recommended)
OPENROUTER_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google (Gemini)
GOOGLE_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# NVIDIA NIM
NVIDIA_NIM_API_KEY=

# Moonshot Kimi
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai

# xAI (Grok)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai
XAI_API_MODE=responses


# ╔══════════════════════════════════════════════════════════════╗
# ║  LLM Configuration (optional)                               ║
# ╚══════════════════════════════════════════════════════════════╝

# Which provider to use: openrouter | openai | anthropic | google | deepseek | nvidia | ollama | litellm
# Choose explicitly; Promethe does not invent a default for account-dependent catalogs.
LLM_PROVIDER=

# Exact provider model ID or LiteLLM alias. Discover it from the provider catalog.
LLM_MODEL=

# Sampling temperature (0.0–2.0)
LLM_TEMPERATURE=0.2

# Max response tokens
LLM_MAX_TOKENS=4096

# Custom base URL (for self-hosted / LiteLLM proxy)
# LLM_BASE_URL=http://localhost:4000

# ╔══════════════════════════════════════════════════════════════╗
# ║  Server Configuration (optional)                             ║
# ╚══════════════════════════════════════════════════════════════╝

# Gateway HTTP port
PORT=8080

# Database URL (default: persistent SQLite file)
# PROMETHE_DB_URL=jdbc:sqlite:./data/promethe.db

# Agent execution backend: docker | local
EXEC_BACKEND=local

# Profiles and skills directories
# PROFILE_DIR=./profiles/developer
# SKILLS_DIR=./skills

# ╔══════════════════════════════════════════════════════════════╗
# ║  Remote access, sessions, and public TLS                    ║
# ╚══════════════════════════════════════════════════════════════╝

# Enable remote owner sessions (requires PROMETHE_MASTER_KEY)
# REMOTE_ACCESS_ENABLED=false

# Public HTTPS origin used for remote access and OAuth callbacks.
# The gateway rejects remote access unless this is an absolute HTTPS URL.
# PUBLIC_BASE_URL=https://gateway.example

# DNS name without a scheme, used by compose.remote.yaml / Caddy.
# PROMETHE_DOMAIN=gateway.example

# Explicit browser/MCP origins, comma-separated; wildcard is not supported.
# CORS_ALLOWED_ORIGINS=https://app.example

# Owner session lifetime, between 15 and 1440 minutes.
# REMOTE_SESSION_TTL_MINUTES=60

# Base64 encoding of exactly 32 bytes. Read from the process environment only.
# PROMETHE_MASTER_KEY=

# Optional key-ring rotation. Previous entries use id=base64 and are comma-separated.
# PROMETHE_MASTER_KEY_ID=primary
# PROMETHE_PREVIOUS_MASTER_KEYS=old-key-id=base64-key

# ╔══════════════════════════════════════════════════════════════╗
# ║  OAuth (optional, requires remote access)                   ║
# ╚══════════════════════════════════════════════════════════════╝

# Enable GitHub and/or Google Calendar OAuth.
# OAUTH_ENABLED=false
# OAUTH_REDIRECT_URI=https://gateway.example/auth/oauth/callback
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# ╔══════════════════════════════════════════════════════════════╗
# ║  Execution tool gates                                       ║
# ╚══════════════════════════════════════════════════════════════╝

# Each tool is disabled unless explicitly enabled.
# CODE_EXECUTION_ENABLED=false
# PROCESS_TOOL_ENABLED=false
# DOCKER_TOOL_ENABLED=false
# PROMETHE_ENABLE_LAB_PLUGINS=false
# PROMETHE_ENABLE_LAB_PLUGINS=false

# Native process sandbox. Unsupported modes fail closed.
# SANDBOX_BACKEND=auto
# SANDBOX_WORKSPACE=
# SANDBOX_MODE=WORKSPACE_WRITE
# SANDBOX_APPROVAL_POLICY=ON_REQUEST
# SANDBOX_NETWORK_MODE=OFF
# SANDBOX_ALLOWED_DOMAINS=

# Experimental harness (personal sandbox only, not for production).
# Read by the application process environment; copying .env alone does not export them.
# See docs/HARNESS_KOTLIN.md. Native sandbox and prepared Kotlin distribution required.
# PROMETHE_ENABLE_HARNESS_MUTATION=false
# PROMETHE_HARNESS_LANGUAGE=kotlin
# PROMETHE_HARNESS_KOTLIN_DIST=<absolute-path-to-harness-kotlin/build/install/harness-kotlin>
# PROMETHE_HARNESS_JAVA_RUNTIME=<absolute-path-to-harness-kotlin/build/runtime/image>
# PROMETHE_HARNESS_KOTLIN_CACHE=true
# Additional opt-in: durable evaluated source library and harness_adapt (local trusted AGENT only).
# PROMETHE_HARNESS_ADAPTIVE=false
# Optional integer owner estimate (0..1000000000) in micro-USD per MiB of new observations.
# Omit for no USD estimate; excludes tokenization and conversation history.
# Not a provider invoice, token tariff, or spending cap.
# PROMETHE_HARNESS_INPUT_MICROUSD_PER_MIB=

# Aggregate admitted starts across sessions of this local profile (not a USD/token budget).
# Process-owned JSON array; [] disables aggregate quotas. At most 128 rules.
# OWNER totals a resource; PROVIDER/TOOL selector '*' means separate counters per encountered name.
# Fixed UTC windows; admitted attempts remain counted after a later failure/cancellation.
# See docs/CONFIGURATION.md#aggregate-resource-quotas and token_budget diagnostics.
# PROMETHE_RESOURCE_QUOTAS=[]
# Example: 100 admitted LLM attempts per local profile per UTC day.
# PROMETHE_RESOURCE_QUOTAS=[{"id":"profile-llm-day","dimension":"OWNER","resource":"LLM_CALL","maxStarts":100,"windowSeconds":86400,"selector":"*"}]

# ╔══════════════════════════════════════════════════════════════╗
# ║  Ollama (local models — optional)                            ║
# ╚══════════════════════════════════════════════════════════════╝

# Ollama server URL (only needed if LLM_PROVIDER=ollama)
# OLLAMA_URL=http://localhost:11434

# ╔══════════════════════════════════════════════════════════════╗
# ║  LiteLLM Proxy (Docker Compose only — optional)              ║
# ╚══════════════════════════════════════════════════════════════╝

# Master key for the LiteLLM proxy
# Required only for the LiteLLM overlay. Generate a dedicated test key.
LITELLM_MASTER_KEY=

# Required when compose.litellm.yaml is enabled; must match a configured LiteLLM alias.
LITELLM_MODEL=

# ╔══════════════════════════════════════════════════════════════╗
# ║  Memory Provider (optional)                                  ║
# ╚══════════════════════════════════════════════════════════════╝

# Which memory provider: embedded | honcho | tencent | fallback
# MEMORY_PROVIDER=embedded

# Honcho Memory (REST API)
# HONCHO_URL=
# HONCHO_API_KEY=

# TencentDB Agent Memory (REST API)
# TENCENT_MEMORY_URL=
# TENCENT_MEMORY_API_KEY=

# ╔══════════════════════════════════════════════════════════════╗
# ║  Observability (optional)                                    ║
# ╚══════════════════════════════════════════════════════════════╝

# Tracing backend: console | langfuse | otlp
# TRACING_BACKEND=console

# Langfuse (if TRACING_BACKEND=langfuse)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# OTLP (if TRACING_BACKEND=otlp)
# OTLP_ENDPOINT=http://localhost:4317

# ╔══════════════════════════════════════════════════════════════╗
# ║  Integrations (optional — tools activate when key is set)   ║
# ╚══════════════════════════════════════════════════════════════╝

# GitHub — issues, PRs, search, actions
# GITHUB_TOKEN=ghp_...

# Email — send emails via HTTP API (Resend, SendGrid, or Mailgun)
# EMAIL_PROVIDER=resend           # resend | sendgrid | mailgun
# EMAIL_API_KEY=re_...
# EMAIL_FROM=noreply@yourdomain.com

# Google Calendar — list/create/delete events
# GOOGLE_CALENDAR_TOKEN=ya29.a0...  # OAuth2 access token

# Notion — search, pages, databases
# NOTION_API_KEY=ntn_...           # Internal integration token

# Jira — issues, search, transitions
# JIRA_URL=https://yourcompany.atlassian.net
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=ATATT3...

# Twilio — SMS + WhatsApp messaging
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1234567890  # Your Twilio phone number

# ╔══════════════════════════════════════════════════════════════╗
# ║  AI Media Providers (optional — multi-provider support)     ║
# ╚══════════════════════════════════════════════════════════════╝

# Image Generation: DALL-E (OPENAI_API_KEY), Imagen (GOOGLE_API_KEY), or:
# STABILITY_API_KEY=sk-...         # Stability AI (Stable Diffusion)
# REPLICATE_API_TOKEN=r8_...       # Replicate (Flux, Luma Ray video)

# Video Generation: set at least ONE
# → Google Veo 3 uses GOOGLE_API_KEY above
# → Replicate Luma uses REPLICATE_API_TOKEN above
# FAL_KEY=...                      # fal.ai (MiniMax Video)
# RUNWAY_API_KEY=...               # Runway Gen-3 Alpha

# Video Analysis: uses GOOGLE_API_KEY (Gemini) or OPENAI_API_KEY (GPT-4o)
# GOOGLE_AI_KEY=...                # Override Google key for Gemini vision/video

# Speech-to-Text: Whisper (OPENAI_API_KEY) or:
# DEEPGRAM_API_KEY=...             # Deepgram STT
# Google Cloud Chirp 3 STT is not implemented in v1 and remains unavailable.

# Text-to-Speech: OpenAI TTS (OPENAI_API_KEY), Google TTS (GOOGLE_API_KEY), or:
# ELEVENLABS_API_KEY=...           # ElevenLabs

# Other canonical provider secrets used by the provider registry
# FAL_KEY=...
# COHERE_API_KEY=...
# VOYAGE_API_KEY=...
# MISTRAL_API_KEY=...

# ╔══════════════════════════════════════════════════════════════╗
# ║  Webhook verification tokens                                 ║
# ╚══════════════════════════════════════════════════════════════╝

# Telegram inbound webhook header token
# TELEGRAM_SECRET_TOKEN=
# WhatsApp Cloud API verification and HMAC app secret
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# Discord interaction signing key
# DISCORD_PUBLIC_KEY=
# Slack Events API signing secret
# SLACK_SIGNING_SECRET=
# Shared bearer tokens for Signal and Matrix inbound webhooks
# SIGNAL_WEBHOOK_TOKEN=
# MATRIX_WEBHOOK_TOKEN=
